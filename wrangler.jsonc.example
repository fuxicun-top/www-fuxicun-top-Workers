{
  // Cloudflare Workers 部署配置
  // 复制此文件为 wrangler.jsonc 并填入实际值
  // main 分支 → 生产环境
  // dev 分支 → 预览环境（共用生产数据库）

  "name": "fuxicun-website",
  "main": "./dist/worker/index.js",
  "compatibility_date": "2024-01-01",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cdn/*", "/articles/*", "/p/*", "/sitemap.xml"]
  },

  "d1_databases": [
    {
      "binding": "FUXICUN_DB",
      "database_name": "your-database-name",
      "database_id": "your-database-id"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "FUXICUN_KV",
      "id": "your-kv-namespace-id"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FUXICUN_BUCKET",
      "bucket_name": "your-r2-bucket-name"
    }
  ],

  "vars": {
    "EMAIL_FROM": "www@fuxicun.top"
  },

  "env": {
    "preview": {
      "name": "fuxicun-website-preview"
    }
  }
}
