# Cloudflare Pages 部署配置
# 复制此文件为 wrangler.toml 并填入实际值
# 本地开发：wrangler pages dev
# 部署：wrangler pages deploy

name = "fuxicun-website"
pages_build_output_dir = "."

# D1 数据库绑定
[[d1_databases]]
binding = "FUXICUN_DB"
database_name = "your-database-name"
database_id = "your-database-id"

# KV 命名空间绑定
[[kv_namespaces]]
binding = "FUXICUN_KV"
id = "your-kv-namespace-id"

# R2 存储桶绑定
[[r2_buckets]]
binding = "FUXICUN_BUCKET"
bucket_name = "your-r2-bucket-name"

# 环境变量
[vars]
EMAIL_FROM = "www@fuxicun.top"
