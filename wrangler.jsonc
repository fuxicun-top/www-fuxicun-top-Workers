{
  // Cloudflare Workers 部署配置
  // main 分支 → 生产环境 (www-fuxicun-top-workers)
  // dev 分支 → 预览环境 (www-fuxicun-top-workers-preview)

  "name": "www-fuxicun-top-workers",
  "main": "./dist/worker/index.js",
  "compatibility_date": "2024-01-01",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cdn/*", "/articles/*", "/p/*", "/sitemap.xml"]
  },

  "d1_databases": [
    {
      "binding": "FUXICUN_DB",
      "database_name": "www-fuxicun-top-d1",
      "database_id": "3766c4a5-2094-4e44-af41-cc1984c22f09"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "FUXICUN_KV",
      "id": "d52d48bf14734363b1c2407941dc008b"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FUXICUN_BUCKET",
      "bucket_name": "www-fuxicun-top-r2"
    }
  ],

  "vars": {
    "EMAIL_FROM": "www@fuxicun.top"
  },

  "env": {
    "preview": {
      "name": "www-fuxicun-top-workers-preview"
    }
  }
}
